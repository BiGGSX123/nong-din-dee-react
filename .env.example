# leave blank to go through Vite's dev proxy (same-origin under https://localhost,
# required so LIFF login redirects work) — set an absolute URL only if not proxying
VITE_API_URL=
# from the LINE Developers Console — leave unset to run in guest mode (no LINE
# login, progress stays local-only) while you don't have LIFF credentials yet
VITE_LIFF_ID=
