# copy to .env.prod at the repo root on the VM (not committed — real values
# only ever live on the server) and fill in real values
POSTGRES_PASSWORD=replace-with-a-long-random-value
SESSION_JWT_SECRET=replace-with-at-least-32-random-characters
# the origin the browser actually uses — http://<server-ip> for now,
# https://<domain> once a domain + certbot are set up
CLIENT_ORIGIN=http://101.44.56.196
# leave blank until LINE LIFF is configured (keeps the app in guest mode)
LINE_CHANNEL_ID=
