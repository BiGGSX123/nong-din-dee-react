# copy to .env.prod at the repo root on the VM (not committed — real values
# only ever live on the server) and fill in real values
POSTGRES_PASSWORD=replace-with-a-long-random-value
SESSION_JWT_SECRET=replace-with-at-least-32-random-characters
# the origin the browser actually uses — http://<server-ip> for now,
# https://<domain> once a domain + certbot are set up
CLIENT_ORIGIN=http://101.44.56.196
# LINE login — leave both blank to keep the app in guest mode. Once set, every
# player must log in with LINE, and only through the LIFF Endpoint URL
# (e.g. https://lddsoilquest.ldd.go.th or inside the LINE app), not the bare IP.
# LINE_CHANNEL_ID: the LINE Login channel (server verifies ID tokens with it)
# VITE_LIFF_ID: the LIFF app id — infra/deploy.sh bakes it into the frontend
LINE_CHANNEL_ID=
VITE_LIFF_ID=
