generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          String          @id @default(cuid())
  lineUserId  String          @unique
  displayName String
  pictureUrl  String?
  points      Int             @default(0)
  // shop items owned, e.g. { "time": 2, "double": 1 } — bought with points
  // via /api/shop (see src/shopItems.js for the catalog + prices)
  items       Json            @default("{}")
  // special characters owned (ids, see src/characters.js) — permanent, each
  // pays a daily bonus; charClaimDate = last Bangkok date it was claimed
  characters  Json            @default("[]")
  charClaimDate String?
  // daily bonus points already claimed on charClaimDate — a character bought
  // after today's claim can top up the difference the same day
  charClaimedBonus Int        @default(0)
  // "player" | "admin" — replaces the old shared ADMIN_TOKEN gate; admin API
  // routes now check this on the logged-in session instead of a bearer secret
  role        String          @default("player")
  // AdminLevel.index of the player's chosen home province — that level becomes
  // their personal starting point (see server/src/levelOrder.js). Loose
  // reference (no FK) since AdminLevel rows can be added/removed by admins.
  homeLevelIndex Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  progress    LevelProgress[]
  pointLogs   PointLog[]
  quizBests   QuizBest[]
}

// best "ถูกหรือผิด?" result per player per mode (easy|medium|hard|survival) —
// the quiz leaderboard. bestScore = round points as awarded (x2 item
// included); bestCorrect = answers right in that run; bestCombo = longest streak
// ever in this mode (tracked on its own, may come from a different run).
model QuizBest {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  mode        String
  bestScore   Int      @default(0)
  bestCorrect Int      @default(0)
  bestCombo   Int      @default(0)
  achievedAt  DateTime @default(now())

  @@unique([playerId, mode])
  @@index([mode, bestScore])
}

// one row per change to Player.points (earned > 0, spent < 0) — the player's
// points history on the profile screen. See server/src/pointLog.js.
model PointLog {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amount    Int
  // level | quiz | shop | character | daily | dividend
  kind      String
  // what it was for: levelIndex / difficulty (":x2" if doubled) / itemId / charId
  ref       String?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

model LevelProgress {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  levelIndex   Int
  completed    Boolean  @default(false)
  locked       Boolean  @default(true)
  stars        Int      @default(0)
  // this level's current point value — Player.points is kept as the sum of
  // every level's `points`, so replaying a level replaces its contribution
  // instead of adding a new one on top (see server/src/routes/progress.js)
  points       Int      @default(0)
  pickedCropId String?
  updatedAt    DateTime @updatedAt

  @@unique([playerId, levelIndex])
}

// admin-editable game content — replaces the old localStorage-backed config
model AdminLevel {
  index          Int    @id
  province       String
  soilId         String
  careCorrectIdx Int
  cropChoices    Json
  cropCorrectId  String
  fertOrder      Json
  fertCorrectIdx Int
}

model AdminCareMethod {
  index Int    @id
  text  String
}

model AdminFertilizer {
  index Int    @id
  label String
  sub   String
}
