DATABASE_URL=postgresql://ndd:ndd@localhost:5436/ndd

# LINE Login / LIFF — from the LINE Developers Console (Login channel)
LINE_CHANNEL_ID=replace-with-line-login-channel-id
SESSION_JWT_SECRET=replace-with-at-least-32-random-characters

PORT=8787
# must be https if testing LINE Login locally — the Vite dev server's basicSsl
# plugin serves the frontend over https://localhost:5183 for that reason
CLIENT_ORIGIN=https://localhost:5183
